<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" prefWidth="450" prefHeight="500" 
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="md.ui.impl.javafx.controller.PanelConductorController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Panel de Conductor - Movilidad Digital" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    
    <Label fx:id="lblEstadoConductor" text="Estado: FUERA_DE_SERVICIO" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

    <ToggleButton fx:id="tglDisponibilidad" text="No Disponible" onAction="#handleCambiarDisponibilidad" prefWidth="200" />

    <Separator />

    <Label text="Viajes Disponibles:" style="-fx-font-weight: bold;" />
    <ListView fx:id="listViajesDisponibles" prefHeight="200" />

    <Button fx:id="btnAceptarViaje" text="Aceptar Viaje Seleccionado" onAction="#handleAceptarViaje" maxWidth="Infinity" style="-fx-base: #2e7d32; -fx-text-fill: white;" /><!-- Botón para aceptar el viaje existente -->
   
    <!-- NUEVO: Botón para volver al Login o ir al Mapa -->
    <Button text="Volver al Login / Salir" onAction="#handleVolverLogin" maxWidth="Infinity" style="-fx-base: #d32f2f; -fx-text-fill: white;" />
	<!-- Botón para aceptar / gestionar el viaje -->
    
    <!-- NUEVO: Botón para ver el historial de servicios -->
    <Button text="Ver Historial de Viajes" onAction="#handleVerHistorial" maxWidth="Infinity" style="-fx-base: #1565c0; -fx-text-fill: white;" />

    </VBox>