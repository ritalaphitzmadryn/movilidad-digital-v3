<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane prefHeight="517.0" prefWidth="735.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.ui.impl.javafx.controller.VentanaPrincipalController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Archivo">
            <items>
              <MenuItem mnemonicParsing="false" text="Salir" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ayuda">
            <items>
              <MenuItem mnemonicParsing="false" text="Acerca de" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <left>
      <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #1b5e20; -fx-padding: 15;" BorderPane.alignment="CENTER">
         <children>
         <!-- TIPO DE SERVICIO (PASAJEROS / ENVIOS) -->
			<Label style="-fx-text-fill: white;" text="Modalidad de Servicio:" />
			<ComboBox fx:id="cbTipoServicioEnum" maxWidth="Infinity" promptText="Seleccionar servicio..." />
			<Label style="-fx-text-fill: white;" text="Tipo de Vehículo:" />
			<ComboBox fx:id="cbTipoVehiculo" maxWidth="Infinity" promptText="Seleccionar vehículo..." />
            <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16px;" text="Panel de Control" />
            
            <!-- Etiqueta de bienvenida personalizada -->
            <Label fx:id="lblBienvenida" text="¡Bienvenido!" style="-fx-text-fill: #e8f5e9; -fx-font-weight: bold; -fx-font-size: 13px;" />
            
            <Label style="-fx-text-fill: white;" text="Tipo de Usuario:" />
            <ComboBox fx:id="cbTipoUsuario" maxWidth="Infinity" promptText="Seleccionar perfil..." />
            
            <!-- ORIGEN: Solo botón y etiqueta informativa -->
            <Label style="-fx-text-fill: white;" text="Origen:" />
            <Button fx:id="btnPincharOrigen" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Seleccionar Origen en Mapa" />
            <Label fx:id="lblOrigenInfo" style="-fx-text-fill: #e8f5e9; -fx-font-size: 12px;" text="No seleccionado" wrapText="true" />

            <!-- DESTINO: Solo botón y etiqueta informativa -->
            <Label style="-fx-text-fill: white;" text="Destino:" />
            <Button fx:id="btnPincharDestino" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Seleccionar Destino en Mapa" />
            <Label fx:id="lblDestinoInfo" style="-fx-text-fill: #e8f5e9; -fx-font-size: 12px;" text="No seleccionado" wrapText="true" />
            
            <Label style="-fx-text-fill: white;" text="Tipo de Servicio:" />
            <ComboBox fx:id="cbTipoServicio" maxWidth="Infinity" />
            
            <!-- Botón de solicitar viaje -->
            <Button fx:id="btnSolicitar" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #ffffff; -fx-text-fill: #1b5e20; -fx-font-weight: bold; -fx-cursor: hand;" text="Solicitar Viaje" />
            
            <!-- Botón para limpiar selecciones y rutas -->
            <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑️ Limpiar Selección" />
            
            <!-- Etiqueta para mostrar los resultados en pantalla -->
            <Label fx:id="lblResultadoViaje" wrapText="true" style="-fx-text-fill: #e8f5e9; -fx-font-size: 13px;" />        
         </children>
      </VBox>
   </left>  
   <center>
      <WebView fx:id="mapWebView" maxWidth="Infinity" maxHeight="Infinity" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>