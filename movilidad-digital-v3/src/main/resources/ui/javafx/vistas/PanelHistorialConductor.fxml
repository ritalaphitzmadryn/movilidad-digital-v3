<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" prefWidth="450" prefHeight="500" 
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="md.ui.impl.javafx.controller.PanelHistorialConductorController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Historial de Viajes Realizados" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    
    <ListView fx:id="listHistorialViajes" prefHeight="350" />

    <Button text="Volver al Panel" onAction="#handleVolverPanel" maxWidth="Infinity" style="-fx-base: #1565c0; -fx-text-fill: white;" />
</VBox>